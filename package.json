{
  "name": "pi-swatches",
  "version": "0.1.0",
  "private": true,
  "description": "A pi extension that adds terminal color swatches to CSS color literals in Markdown.",
  "type": "module",
  "files": ["src", "README.md", "package.json"],
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "@earendil-works/pi-tui": ">=0.86.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "^0.86.1",
    "typescript": "^5.7.0"
  }
}
